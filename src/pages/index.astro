---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import CodeIcon from "@/components/icons/Code.astro"
import ContactCTA from "@/components/ContactCTA.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import InvestigationFlow from "@/components/InvestigationFlow.astro"
import OtherDigitalProjects from "@/components/OtherDigitalProjects.astro"
import ProblemReality from "@/components/ProblemReality.astro"
import StackSummary from "@/components/StackSummary.astro"
import TitleSection from "@/components/TitleSection.astro"
import CaseStudies from "@/components/CaseStudies.astro"
import BookOpen from "@/components/icons/BookOpen.astro"
---

<Layout
  title="Luis Iván Payero — Data Platform & Reporting Reliability"
  description="Troubleshooting-oriented Data Platform and Analytics Engineering: reliable reporting, warehouse-first architecture, AWS FinOps and production data systems."
  lang="en"
  alternatePath="/es/"
>
  <main class="px-4">
    <SectionContainer class="pt-32 pb-20 md:pt-44 md:pb-32">
      <Hero lang="en" />
    </SectionContainer>

    <div class="space-y-24 md:space-y-32">
      <SectionContainer id="systems">
        <ProblemReality lang="en" />
      </SectionContainer>

      <SectionContainer id="case-studies">
        <TitleSection>
          <BookOpen class="size-7" />
          Technical investigations
        </TitleSection>
        <CaseStudies lang="en" />
      </SectionContainer>

      <SectionContainer id="thinking">
        <InvestigationFlow lang="en" />
      </SectionContainer>

      <SectionContainer id="about">
        <TitleSection>
          <ProfileCheck class="size-8" />
          About
        </TitleSection>
        <AboutMe lang="en" />
      </SectionContainer>

      <SectionContainer id="stack">
        <TitleSection>
          <CodeIcon class="size-7" />
          Technical stack
        </TitleSection>
        <StackSummary lang="en" />
      </SectionContainer>

      <SectionContainer id="other-work">
        <OtherDigitalProjects lang="en" />
      </SectionContainer>

      <SectionContainer id="contact" class="pb-4">
        <ContactCTA lang="en" />
      </SectionContainer>
    </div>
  </main>
</Layout>
