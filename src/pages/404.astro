---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
---

<Layout
  title="404 — Luis Iván Payero"
  description="Página no encontrada / Page not found"
  lang="es"
>
  <main class="px-4">
    <SectionContainer class="pt-32 pb-20 md:pt-44 md:pb-32">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-[#0074A8] dark:text-sky-300">
          Error 404
        </p>

        <h1 class="mt-5 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl dark:text-white">
          Página no encontrada
          <span class="block text-2xl font-semibold tracking-tight text-slate-500 sm:text-3xl dark:text-slate-400">
            Page not found
          </span>
        </h1>

        <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
          La URL que seguiste no existe o fue movida.
          <span class="block text-base text-slate-500 dark:text-slate-400">
            The URL you followed does not exist or was moved.
          </span>
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <a
            href="/en/"
            class="inline-flex items-center justify-center rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white shadow-xl shadow-slate-950/10 transition hover:-translate-y-0.5 hover:bg-[#004F8B] focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2 dark:bg-white dark:text-slate-950 dark:hover:bg-sky-200 dark:focus-visible:ring-offset-slate-950"
          >
            Go to home
          </a>
          <a
            href="/"
            class="inline-flex items-center justify-center rounded-full border border-slate-200/80 bg-white/70 px-5 py-3 text-sm font-semibold text-slate-800 backdrop-blur transition hover:-translate-y-0.5 hover:border-[#004F8B] hover:text-[#004F8B] focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300 focus-visible:ring-offset-2 dark:border-white/10 dark:bg-white/[0.04] dark:text-white dark:hover:border-sky-300 dark:hover:text-sky-200 dark:focus-visible:ring-offset-slate-950"
          >
            Ir al inicio
          </a>
        </div>
      </div>
    </SectionContainer>
  </main>
</Layout>
