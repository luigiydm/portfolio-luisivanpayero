---
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"

interface Props {
  lang?: "en" | "es"
}

const { lang = "en" } = Astro.props
const isEs = lang === "es"
const contactHref = isEs
  ? "mailto:luisivanpayero@gmail.com?subject=Quiero%20contarte%20un%20problema%20de%20reportes%20o%20datos"
  : "mailto:luisivanpayero@gmail.com?subject=I%20want%20to%20tell%20you%20about%20a%20reporting%20or%20data%20problem"

const t = isEs
  ? {
      eyebrow: "Siguiente paso",
      title: "Mandame el reporte, proceso o problema que hoy te está trabando.",
      description:
        "No hace falta que tengas clara la solución ni un brief formal. Con contarme qué proceso te está comiendo tiempo o qué número no cierra, alcanza para empezar.",
      primary: "Contame tu caso",
      secondary: "Escribime por LinkedIn",
    }
  : {
      eyebrow: "Next step",
      title: "Send me the report, process or problem that's slowing you down today.",
      description:
        "You don't need to have the solution figured out, or a formal brief. Just tell me which process is eating your time or which number doesn't add up — that's enough to start.",
      primary: "Tell me about your case",
      secondary: "Message me on LinkedIn",
    }
---

<div class="relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-slate-950 p-7 text-white shadow-2xl shadow-slate-950/20 dark:border-white/10 md:p-10">
  <div class="absolute -right-20 -top-20 size-64 rounded-full bg-[#00AEEF]/20 blur-3xl"></div>
  <div class="absolute -bottom-24 left-8 size-52 rounded-full bg-[#004F8B]/30 blur-3xl"></div>

  <div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.22em] text-sky-200">{t.eyebrow}</p>
      <h2 class="mt-4 max-w-3xl text-3xl font-bold tracking-tight sm:text-4xl">{t.title}</h2>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300">{t.description}</p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <a href={contactHref} class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-sky-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-200 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
        <MailIcon class="size-4" />
        {t.primary}
      </a>
      <a href="https://www.linkedin.com/in/luis-ivan-payero-324873136/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-sky-200 hover:text-sky-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-200 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950">
        <LinkedInIcon class="size-4" />
        {t.secondary}
      </a>
    </div>
  </div>
</div>
