---
import ThemeToggle from "./ThemeToggle.astro"

interface Props {
  lang?: "en" | "es"
  alternatePath?: string
}

const { lang = "en", alternatePath } = Astro.props
const isEs = lang === "es"
const homePath = isEs ? "/es/" : "/"
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
const isHome = isEs ? currentPath === "/es" : currentPath === "/"
const sectionHref = (id: string) => (isHome ? `#${id}` : `${homePath}#${id}`)
const langSwitch = isEs
  ? { title: "EN", label: "Switch to English", url: alternatePath ?? "/" }
  : { title: "ES", label: "Cambiar a español", url: alternatePath ?? "/es/" }

const navItems = [
  {
    title: isEs ? "Sistemas" : "Systems",
    label: "systems",
    url: sectionHref("systems"),
  },
  {
    title: isEs ? "Casos" : "Cases",
    label: "case-studies",
    url: sectionHref("case-studies"),
  },
  {
    title: isEs ? "Cómo pienso" : "Thinking",
    label: "thinking",
    url: sectionHref("thinking"),
  },
  {
    title: isEs ? "Sobre mí" : "About",
    label: "about",
    url: sectionHref("about"),
  },
  {
    title: isEs ? "Contacto" : "Contact",
    label: "contact",
    url: sectionHref("contact"),
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full px-2 mx-auto mt-3"
>
  <nav
    id="header-nav"
    aria-label={isEs ? "Navegación principal" : "Primary"}
    class="flex max-w-[calc(100vw-1rem)] items-center gap-1 rounded-full border border-slate-200/80 px-2 text-xs font-medium text-slate-600 shadow-2xl shadow-slate-950/5 dark:border-white/10 dark:text-zinc-300 dark:shadow-black/30 sm:px-3 sm:text-sm"
  >
    <div class="nav-scroll flex flex-1 items-center overflow-x-auto scrollbar-none">
      {
        navItems.map((link) => (
          <a
            class="nav-link relative block whitespace-nowrap px-2.5 py-2 transition hover:text-slate-950 dark:hover:text-white"
            aria-label={link.label}
            data-section-link={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </div>
    <div class="flex shrink-0 items-center gap-1 border-l border-slate-200/70 pl-1 dark:border-white/10">
      <a
        class="relative block whitespace-nowrap px-2.5 py-2 font-semibold text-sky-700 transition hover:text-[#004F8B] dark:text-sky-300 dark:hover:text-white"
        aria-label={langSwitch.label}
        href={langSwitch.url}
      >
        {langSwitch.title}
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </nav>
</header>

<script is:inline>
  ;(() => {
    if (window.__headerNavCaptureBound) return
    window.__headerNavCaptureBound = true

    const normalize = (path) => path.replace(/\/$/, "") || "/"

    document.addEventListener(
      "click",
      (event) => {
        if (event.defaultPrevented || event.button !== 0) return
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return

        const link = event.target && event.target.closest && event.target.closest("a[data-section-link]")
        if (!link) return

        const href = link.getAttribute("href")
        if (!href || href.indexOf("#") === -1) return

        const url = new URL(href, window.location.href)
        if (normalize(url.pathname) !== normalize(window.location.pathname)) return

        const targetId = url.hash.slice(1)
        const target = targetId && document.getElementById(targetId)
        if (!target) return

        event.preventDefault()
        event.stopImmediatePropagation()

        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
        target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" })
        history.pushState(null, "", "#" + targetId)
        window.dispatchEvent(new CustomEvent("header-nav:active", { detail: { id: targetId } }))
      },
      true
    )
  })()
</script>

<script>
  const initHeaderNav = () => {
    const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("header nav a[data-section-link]"))
    const sections = Array.from(document.querySelectorAll<HTMLElement>("section[id]"))
    if (!sectionLinks.length || !sections.length) return

    const setActive = (id: string) => {
      sectionLinks.forEach((item) => {
        const isActive = item.dataset.sectionLink === id
        item.classList.toggle("text-sky-700", isActive)
        item.classList.toggle("dark:text-sky-300", isActive)
        item.classList.toggle("nav-link--active", isActive)
        if (isActive) {
          item.setAttribute("aria-current", "location")
        } else {
          item.removeAttribute("aria-current")
        }
      })
    }

    ;(window as any).__headerNavObserver?.disconnect()

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id)
        })
      },
      {
        root: null,
        rootMargin: "-20% 0px -55% 0px",
        threshold: 0.01,
      }
    )

    sections.forEach((section) => observer.observe(section))
    ;(window as any).__headerNavObserver = observer
    ;(window as any).__headerNavSetActive = setActive

    if (window.location.hash) {
      const currentId = window.location.hash.slice(1)
      if (document.getElementById(currentId)) setActive(currentId)
    }
  }

  const handleNavActive = (event: Event) => {
    const id = (event as CustomEvent<{ id: string }>).detail?.id
    const setActive = (window as any).__headerNavSetActive
    if (id && typeof setActive === "function") setActive(id)
  }

  initHeaderNav()
  window.addEventListener("header-nav:active", handleNavActive)
</script>

<style>
  nav {
    background: rgba(255, 255, 255, 0.74);
    backdrop-filter: blur(14px);
    box-shadow: 0 18px 45px -24px rgba(2, 6, 23, 0.25);
  }

  @supports (animation-timeline: scroll()) {
    nav {
      animation: nav-shadown 1s linear both;
      animation-timeline: scroll();
      animation-range: 0 100px;
    }
  }

  .nav-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    mask-image: linear-gradient(to right, transparent 0, #000 12px, #000 calc(100% - 12px), transparent 100%);
  }

  .nav-scroll::-webkit-scrollbar {
    display: none;
  }

  :global(.dark) nav {
    background: rgba(8, 8, 10, 0.72);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 0.35rem;
    width: 0;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform: translateX(-50%);
    transition: width 180ms ease;
  }

  .nav-link.nav-link--active::after {
    width: 1.1rem;
  }

  @keyframes nav-shadown {
    0% {
      box-shadow: none;
    }
    to {
      box-shadow: 0 18px 45px -24px rgba(2, 6, 23, 0.45), 0 0 0 1px rgba(125, 220, 255, 0.12);
      backdrop-filter: blur(14px);
    }
  }
</style>
