---
/**
 * The evidence chain behind the AI-written code. Deliberately plain: a line, not cards.
 */
interface Props {
  lang?: "es" | "en"
}
const { lang = "es" } = Astro.props

const T = {
  es: {
    label: "Cadena de evidencia",
    steps: ["Código generado por IA", "Caso con respuestas conocidas", "Tests", "Herramientas oficiales", "Paridad con la versión anterior", "Validación real en solo lectura"],
  },
  en: {
    label: "Evidence chain",
    steps: ["AI-generated code", "Known fixture", "Tests", "Official tools", "Parity with the previous version", "Real-world read-only validation"],
  },
}[lang]
---

<ol class="m-0 my-6 flex list-none flex-col gap-1 border-l-2 border-sky-500 p-0 pl-4 text-[15px] font-semibold text-slate-800 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-2 sm:gap-y-1 dark:text-slate-100" aria-label={T.label}>
  {T.steps.map((step, i) => (
    <li class="flex items-center gap-2">
      {i > 0 && <span class="text-sky-500" aria-hidden="true"><span class="sm:hidden">↓</span><span class="hidden sm:inline">→</span></span>}
      <span class:list={[i === 0 && "text-slate-500 dark:text-slate-400"]}>{step}</span>
    </li>
  ))}
</ol>
