---
/**
 * The three levels (valid / coherent / correct). Static on purpose.
 * Horizontal on desktop, stacked on mobile.
 */
interface Props {
  lang?: "es" | "en"
}
const { lang = "es" } = Astro.props

const T = {
  es: {
    label: "Tres niveles de control",
    levels: [
      { tag: "Nivel 1 · Válido", q: "¿Power BI lo puede leer?", who: "Validadores de Microsoft (TMDL y PBIR)", body: "El parser oficial de TMDL y el CLI de PBIR. Detectan un modelo que ni siquiera abriría en Desktop, con archivo y línea." },
      { tag: "Nivel 2 · Coherente", q: "¿Las piezas del reporte son coherentes entre sí?", who: "pbip-guardrails", body: "Lee el DAX de cada medida junto con los filtros del visual que la usa: medidas inexistentes, filtros incompatibles, poblaciones mezcladas, visuales tapados.", key: true },
      { tag: "Nivel 3 · Correcto", q: "¿El número representa lo que el negocio cree?", who: "Personas + conciliación con los datos de origen", body: "Ninguna herramienta lo responde. Requiere criterio de negocio y comparar contra la fuente." },
    ],
    foot: "No compiten: cada nivel responde una pregunta que el anterior no puede responder.",
  },
  en: {
    label: "Three levels of checks",
    levels: [
      { tag: "Level 1 · Valid", q: "Can Power BI parse it?", who: "Microsoft validators (TMDL and PBIR)", body: "The official TMDL parser and the PBIR CLI. They catch a model that wouldn't even open in Desktop, with file and line." },
      { tag: "Level 2 · Coherent", q: "Are the pieces of the report coherent with each other?", who: "pbip-guardrails", body: "Reads each measure's DAX together with the filters of the visual that uses it: missing measures, incompatible filters, mixed populations, hidden visuals.", key: true },
      { tag: "Level 3 · Correct", q: "Does the number represent what the business thinks?", who: "People + reconciliation with the source data", body: "No tool answers it. It takes business judgement and a comparison against the source." },
    ],
    foot: "They don't compete: each level answers a question the previous one can't.",
  },
}[lang] as { label: string; foot: string; levels: { tag: string; q: string; who: string; body: string; key?: boolean }[] }
---

<figure class="my-8" aria-label={T.label}>
  <ol class="m-0 grid list-none gap-3 p-0 md:grid-cols-3 md:gap-5">
    {T.levels.map((l, i) => (
      <li class="relative">
        {i > 0 && <span class="absolute -top-3 left-6 text-slate-400 md:hidden" aria-hidden="true">↓</span>}
        {i > 0 && <span class="absolute -left-[1.05rem] top-1/2 hidden -translate-y-1/2 text-slate-400 md:block" aria-hidden="true">→</span>}
        <div class:list={[
          "h-full rounded-2xl border-2 p-4",
          l.key
            ? "border-sky-400 bg-sky-50 dark:border-sky-400/50 dark:bg-sky-400/10"
            : "border-slate-200 bg-white dark:border-white/10 dark:bg-slate-900",
        ]}>
          <div class:list={["text-[11px] font-bold uppercase tracking-[0.14em]", l.key ? "text-[#0074A8] dark:text-sky-300" : "text-slate-500 dark:text-slate-400"]}>{l.tag}</div>
          <div class="mt-2 text-lg font-bold leading-snug text-slate-900 dark:text-white">{l.q}</div>
          <div class:list={["mt-2 text-sm font-semibold", l.key ? "font-mono text-[#004F8B] dark:text-sky-200" : "text-slate-700 dark:text-slate-200"]}>{l.who}</div>
          <div class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{l.body}</div>
        </div>
      </li>
    ))}
  </ol>
  <figcaption class="mt-3 text-center text-sm text-slate-500 dark:text-slate-400">{T.foot}</figcaption>
</figure>
